{
  "name": "ecell",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server": "node backend/server.js",
    "start": "node backend/server.js",
    "preclient": "npm run content:export",
    "client": "vite",
    "prebuild": "npm run content:export",
    "build": "node scripts/build.mjs",
    "check:config": "node scripts/check-config.mjs",
    "storage:configure": "node scripts/configure-neon-storage.mjs",
    "backup": "node scripts/backup.mjs",
    "lint": "eslint . --ext js,jsx,mjs --report-unused-disable-directives --max-warnings 0",
    "test": "node --test backend/tests/*.test.js src/content/*.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "content:export": "node scripts/export-content.mjs",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "axios": "^1.8.4",
    "body-parser": "^2.2.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^17.0.1",
