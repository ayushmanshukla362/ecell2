    "leaflet": "^1.9.4",
    "lucide-react": "^0.510.0",
    "nodemailer": "^10.0.14",
    "pg": "^8.23.1",
    "react": "^18.2.0",
    "react-awesome-reveal": "^4.2.13",
    "react-dom": "^18.2.0",
    "react-icons": "^5.2.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.18.4",
    "react-slick": "^0.30.2",
    "sharp": "^0.35.5",
    "slick-carousel": "^1.8.1",
    "styled-components": "^6.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
